{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "*.ts"]
}

{
  "name": "marionette-realworld-example-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:e2e": "playwright test --config playwright.realworld.config.mjs",
    "test:e2e:list": "playwright test --config playwright.realworld.config.mjs --list",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests docs README.md *.ts *.json *.mjs index.html",
    "format:check": "prettier --check src tests docs README.md *.ts *.json *.mjs index.html",
    "test:production": "TEST_PRODUCTION=1 playwright test --project=chromium"
  },
  "dependencies": {
    "@mnjs/adapters": "5.0.0-rc.2",
    "@mnjs/data": "5.0.0-rc.2",
    "@mnjs/radio": "5.0.0-rc.2",
    "@mnjs/utils": "5.0.0-rc.2",
    "dompurify": "3.4.16",
    "lit-html": "3.3.3",
    "marionette": "5.0.0-rc.2",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
